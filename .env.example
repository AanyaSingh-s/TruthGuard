# TruthGuard Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.
# DO NOT commit real secrets, API keys, or production credentials to version control.

# ---------------------------------------------------------------------------
# Database Configuration (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=truthguard
POSTGRES_USER=truthguard
POSTGRES_PASSWORD=truthguard_dev_password

# ---------------------------------------------------------------------------
# Spring Boot Backend Service
# ---------------------------------------------------------------------------
BACKEND_PORT=8080
BACKEND_HOST=0.0.0.0
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# Python FastAPI AI Service & LLM Configuration
# ---------------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_ENV=development

# LLM Provider: gemini | openai | mock
# Note: When an API key is provided, the real provider is the default.
# 'mock' may ONLY be used when LLM_PROVIDER=mock is explicitly set.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# API Keys (set at least one real key for live inference)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
# Set to 'true' ONLY during unit tests to enable deterministic hash fallback
EMBEDDINGS_FALLBACK=false

# ---------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ---------------------------------------------------------------------------
VITE_BACKEND_API_URL=http://localhost:8080/api/v1
VITE_AI_SERVICE_API_URL=http://localhost:8000/api/v1
VITE_APP_PORT=3000
